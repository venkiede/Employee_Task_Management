{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "services": {
    "backend": {
      "source": {
        "root": "backend"
      },
      "deploy": {
        "startCommand": "python init_db.py && gunicorn config.wsgi --bind 0.0.0.0:$PORT"
      }
    },
    "frontend": {
      "source": {
        "root": "frontend"
      },
      "variables": {
        "NIXPACKS_NODE_VERSION": "20"
      }
    }
  }
}
